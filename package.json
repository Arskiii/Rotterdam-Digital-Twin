{
  "name": "rotterdam-intelligence-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rotterdam Intelligence Platform \u2014 city-wide 3D traffic simulation on the real OSM street network",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-publish-guards.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch-data": "node scripts/fetch-osm.mjs",
    "build-data": "node scripts/build-data.mjs",
    "fetch-ndw": "NODE_USE_ENV_PROXY=1 node scripts/fetch-ndw.mjs",
    "fetch-live": "NODE_USE_ENV_PROXY=1 node scripts/fetch-live.mjs",
    "fetch-stops": "NODE_USE_ENV_PROXY=1 node scripts/fetch-gtfs-stops.mjs",
    "fetch-timetable": "NODE_USE_ENV_PROXY=1 node scripts/fetch-gtfs-timetable.mjs",
    "fetch-heights": "NODE_USE_ENV_PROXY=1 node scripts/fetch-heights.mjs",
    "fetch-roofs": "NODE_USE_ENV_PROXY=1 node scripts/fetch-lod2.mjs",
    "apply-heights": "node scripts/apply-heights.mjs",
    "audit-buildings": "node scripts/audit-buildings.mjs",
    "check-workflows": "node scripts/check-publish-guards.mjs"
  },
  "dependencies": {
    "earcut": "^3.2.3",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/earcut": "^2.1.4",
    "@types/three": "^0.166.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
